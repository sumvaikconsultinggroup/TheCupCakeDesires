# ────────────────────────────────────────────────────────────
#  The Cupcake Desire — env reference
#  Copy to `.env.local` and fill in real values. Never commit secrets.
# ────────────────────────────────────────────────────────────

# ─── MongoDB (required) ───
# Production data lives in Atlas. For local you can use mongodb://localhost:27017/cupcake
MONGODB_URI=

# ─── Clerk authentication (required) ───
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Webhook secret for /api/webhooks/clerk so we sync new sign-ups into our users collection
CLERK_WEBHOOK_SECRET=whsec_...
# Point Clerk at our branded pages (without these, protect() sends users to accounts.dev)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ─── Stripe payments (required for checkout) ───
# Grab keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret from https://dashboard.stripe.com/webhooks
# Endpoint URL to register: <YOUR_SITE_URL>/api/stripe/webhook
# Events to subscribe to:
#   checkout.session.completed
#   payment_intent.succeeded
#   payment_intent.payment_failed
#   charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Site origin (optional but recommended) ───
# Used as a fallback for Stripe Checkout success/cancel URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── OpenAI (storefront AI assistant) ───
# Powers the "Shop with AI" chat bubble. Without this set, the assistant
# returns 503 and the floating button still appears but messages fail.
OPENAI_API_KEY=sk-...
# Optional: override the assistant model. Defaults to gpt-4o-mini.
# OPENAI_ASSISTANT_MODEL=gpt-4o-mini

# ─── Resend (transactional + newsletter + contact forms) ───
RESEND_API_KEY=re_...
# Must match a verified domain in Resend (defaults shown if omitted)
# RESEND_FROM_EMAIL=The Cupcake Desire <info@thecupcakedesire.com.au>
# RESEND_REPLY_TO=info@thecupcakedesire.com.au
# Inbox for all website enquiry forms (contact, corporate, product, dress cake).
# Defaults to info@thecupcakedesire.com.au when omitted.
# CONTACT_TO_EMAIL=info@thecupcakedesire.com.au

# Signing secret for the "manage your booking" links emailed to customers.
# A guest has no account, so this signed token is what proves the link belongs to
# them — treat it like a password and never commit the real value.
# Generate with: openssl rand -hex 32
# Required in production. Falls back to EMAIL_UNSUBSCRIBE_SECRET if that is set.
ORDER_ACCESS_SECRET=

# ─── Cloudinary (image uploads) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Admin JWT signing (server-only) ───
JWT_SECRET=
