<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Order Confirmed</title>
</head>
<body style="margin:0;padding:0;background-color:#fbf3e8;font-family:Arial,'Helvetica Neue',Helvetica,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#fbf3e8;">
<tr><td align="center" style="padding:32px 16px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background-color:#ffffff;">

<tr>
<td style="background-color:#2e1f15;padding:24px 40px;text-align:center;">
<p style="margin:0;color:#ffffff;font-size:18px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;">The Cupcake Desire</p>
</td>
</tr>

<tr>
<td style="padding:36px 40px;">
<h2 style="margin:0 0 20px;font-size:22px;color:#2e1f15;font-weight:700;">Order Confirmed</h2>
<p style="margin:0 0 8px;font-size:15px;color:#5a4634;line-height:1.7;">Thank you for your order, {{name}}.</p>

<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:16px 0;background-color:#fffbf6;border-radius:4px;">
<tr>
<td style="padding:12px 16px;">
<p style="margin:0;font-size:12px;color:#8b7359;">Order Number</p>
<p style="margin:4px 0 0;font-size:15px;color:#2e1f15;font-weight:700;">{{orderId}}</p>
</td>
<td style="padding:12px 16px;text-align:right;">
<p style="margin:0;font-size:12px;color:#8b7359;">Date</p>
<p style="margin:4px 0 0;font-size:14px;color:#2e1f15;font-weight:600;">{{orderDate}}</p>
</td>
</tr>
</table>

<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;border:1px solid #ead9c1;border-radius:4px;overflow:hidden;">
<tr style="background-color:#fffbf6;">
<th style="padding:10px 12px;text-align:left;font-size:12px;color:#8b7359;font-weight:600;text-transform:uppercase;border-bottom:1px solid #ead9c1;" width="60">Image</th>
<th style="padding:10px 12px;text-align:left;font-size:12px;color:#8b7359;font-weight:600;text-transform:uppercase;border-bottom:1px solid #ead9c1;">Product</th>
<th style="padding:10px 12px;text-align:center;font-size:12px;color:#8b7359;font-weight:600;text-transform:uppercase;border-bottom:1px solid #ead9c1;" width="50">Qty</th>
<th style="padding:10px 12px;text-align:right;font-size:12px;color:#8b7359;font-weight:600;text-transform:uppercase;border-bottom:1px solid #ead9c1;" width="80">Price</th>
</tr>
{{#each products}}
<tr>
<td style="padding:10px 12px;border-bottom:1px solid #f4e9d6;"><img src="{{this.variant.image}}" alt="{{this.title}}" width="48" height="48" style="border-radius:4px;display:block;object-fit:cover;" /></td>
<td style="padding:10px 12px;border-bottom:1px solid #f4e9d6;font-size:14px;color:#2e1f15;">{{this.title}}<br><span style="font-size:12px;color:#8b7359;">{{this.variant.option1Value}}{{#if this.variant.option2Value}} / {{this.variant.option2Value}}{{/if}}</span></td>
<td style="padding:10px 12px;border-bottom:1px solid #f4e9d6;font-size:14px;color:#5a4634;text-align:center;">{{this.quantity}}</td>
<td style="padding:10px 12px;border-bottom:1px solid #f4e9d6;font-size:14px;color:#2e1f15;font-weight:600;text-align:right;">${{this.totalPrice}}</td>
</tr>
{{/each}}
<tr style="background-color:#fffbf6;">
<td colspan="3" style="padding:12px;font-size:15px;color:#2e1f15;font-weight:700;text-align:right;">Total Paid</td>
<td style="padding:12px;font-size:15px;color:#2e1f15;font-weight:700;text-align:right;">${{total}}</td>
</tr>
</table>

<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:20px 0;">
<tr>
<td style="padding:12px 16px;background-color:#fffbf6;border-radius:4px;" width="48%">
<p style="margin:0;font-size:12px;color:#8b7359;font-weight:600;text-transform:uppercase;">Payment Method</p>
<p style="margin:6px 0 0;font-size:14px;color:#2e1f15;font-weight:600;">{{paymentMethod}}</p>
</td>
<td width="4%"></td>
<td style="padding:12px 16px;background-color:#fffbf6;border-radius:4px;" width="48%">
<p style="margin:0;font-size:12px;color:#8b7359;font-weight:600;text-transform:uppercase;">Delivery Address</p>
<p style="margin:6px 0 0;font-size:13px;color:#2e1f15;line-height:1.5;">{{address}}</p>
</td>
</tr>
</table>
</td>
</tr>

<tr>
<td style="padding:24px 40px;border-top:1px solid #ead9c1;text-align:center;">
<p style="margin:0 0 4px;color:#8b7359;font-size:13px;font-weight:600;">The Cupcake Desire</p>
<p style="margin:0;color:#a89478;font-size:11px;">Please do not reply directly to this email.</p>
</td>
</tr>

</table>
</td></tr>
</table>
</body>
</html>
