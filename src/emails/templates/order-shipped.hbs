<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Order Shipped</title>
</head>
<body style="margin:0;padding:0;background-color:#fbf3e8;font-family:Arial,'Helvetica Neue',Helvetica,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#fbf3e8;">
<tr><td align="center" style="padding:32px 16px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background-color:#ffffff;">

<tr>
<td style="background-color:#2e1f15;padding:24px 40px;text-align:center;">
<p style="margin:0;color:#ffffff;font-size:18px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;">The Cupcake Desire</p>
</td>
</tr>

<tr>
<td style="padding:36px 40px;">
<h2 style="margin:0 0 20px;font-size:22px;color:#2e1f15;font-weight:700;">Your Order Has Shipped</h2>
<p style="margin:0 0 8px;font-size:15px;color:#5a4634;line-height:1.7;">Hi {{name}},</p>
<p style="margin:0 0 20px;font-size:15px;color:#5a4634;line-height:1.7;">Your order <strong>{{orderId}}</strong> is on its way.</p>

<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;background-color:#fffbf6;border-radius:4px;">
<tr>
<td style="padding:16px;">
<p style="margin:0 0 8px;font-size:12px;color:#8b7359;font-weight:600;text-transform:uppercase;">Tracking Details</p>
<p style="margin:0 0 4px;font-size:14px;color:#5a4634;">Courier: <strong style="color:#2e1f15;">{{carrier}}</strong></p>
<p style="margin:0;font-size:14px;color:#5a4634;">AWB Number: <strong style="color:#2e1f15;">{{trackingNumber}}</strong></p>
</td>
</tr>
</table>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;">
<tr><td align="center" style="border-radius:4px;background-color:#2e1f15;">
<a href="{{trackingUrl}}" style="display:inline-block;padding:12px 28px;font-size:14px;font-weight:600;color:#ffffff;text-decoration:none;">Track Your Package</a>
</td></tr>
</table>

<p style="margin:0;font-size:14px;color:#8b7359;line-height:1.6;">Delivery typically takes 3-5 business days depending on your location.</p>
</td>
</tr>

<tr>
<td style="padding:24px 40px;border-top:1px solid #ead9c1;text-align:center;">
<p style="margin:0 0 4px;color:#8b7359;font-size:13px;font-weight:600;">The Cupcake Desire</p>
<p style="margin:0;color:#a89478;font-size:11px;">Please do not reply directly to this email.</p>
</td>
</tr>

</table>
</td></tr>
</table>
</body>
</html>
