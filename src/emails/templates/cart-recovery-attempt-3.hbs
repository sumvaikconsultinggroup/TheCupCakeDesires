<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Final Reminder</title>
</head>
<body style="margin:0;padding:0;background-color:#f5f5f5;font-family:Arial,'Helvetica Neue',Helvetica,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f5f5f5;">
<tr><td align="center" style="padding:32px 16px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background-color:#ffffff;">

<tr>
<td style="background-color:#1B198F;padding:24px 40px;text-align:center;">
<p style="margin:0;color:#ffffff;font-size:18px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;">CupCake Desires</p>
</td>
</tr>

<tr>
<td style="padding:36px 40px;">
<h2 style="margin:0 0 20px;font-size:22px;color:#111827;font-weight:700;">Final Reminder</h2>
<p style="margin:0 0 8px;font-size:15px;color:#374151;line-height:1.7;">Hi {{userName}},</p>
<p style="margin:0 0 24px;font-size:15px;color:#374151;line-height:1.7;">This is your last reminder. Your cart will expire shortly. Complete your order now and enjoy <strong>free shipping</strong>.</p>

<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;border:1px solid #1B198F;border-radius:4px;">
<tr>
<td style="padding:16px;text-align:center;">
<p style="margin:0 0 4px;font-size:16px;color:#1B198F;font-weight:700;">FREE SHIPPING</p>
<p style="margin:0;font-size:12px;color:#6b7280;">On this order only &middot; Limited time</p>
</td>
</tr>
</table>

<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;background-color:#fef2f2;border-radius:4px;">
<tr>
<td style="padding:14px 16px;text-align:center;">
<p style="margin:0 0 4px;font-size:14px;color:#991b1b;font-weight:600;">Cart Expires Soon</p>
<p style="margin:0;font-size:13px;color:#991b1b;">Complete your order within the next few hours or your items will be released.</p>
</td>
</tr>
</table>

{{#each items}}
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:10px;background-color:#f9fafb;border-radius:4px;">
<tr>
<td style="padding:12px;" width="70"><img src="{{imageUrl}}" alt="{{productName}}" width="56" height="56" style="border-radius:4px;display:block;object-fit:cover;" /></td>
<td style="padding:12px;">
<p style="margin:0;font-size:14px;color:#111827;font-weight:600;">{{productName}}</p>
<p style="margin:2px 0 0;font-size:12px;color:#6b7280;">{{variant.option1Value}} &middot; Qty: {{quantity}}</p>
</td>
<td style="padding:12px;text-align:right;font-size:14px;color:#111827;font-weight:600;" width="80">&#8377;{{price}}</td>
</tr>
</table>
{{/each}}

<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:20px 0;background-color:#f9fafb;border-radius:4px;">
<tr><td style="padding:10px 16px;font-size:14px;color:#374151;">Subtotal</td><td style="padding:10px 16px;text-align:right;font-size:14px;color:#374151;">&#8377;{{totalValue}}</td></tr>
<tr><td style="padding:4px 16px;font-size:14px;color:#059669;">Shipping</td><td style="padding:4px 16px;text-align:right;font-size:14px;color:#059669;font-weight:600;">FREE</td></tr>
<tr><td style="padding:10px 16px;font-size:16px;color:#111827;font-weight:700;border-top:1px solid #e5e7eb;">Total</td><td style="padding:10px 16px;text-align:right;font-size:16px;color:#1B198F;font-weight:700;border-top:1px solid #e5e7eb;">&#8377;{{totalValue}}</td></tr>
</table>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:24px 0;">
<tr><td align="center" style="border-radius:4px;background-color:#1B198F;">
<a href="{{resumeUrl}}" style="display:inline-block;padding:14px 32px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;width:100%;text-align:center;box-sizing:border-box;">Complete Order Now</a>
</td></tr>
</table>

<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f9fafb;border-radius:4px;">
<tr><td style="padding:14px 16px;font-size:13px;color:#374151;line-height:1.6;">
<strong>Why shop with us?</strong><br>
&bull; 100% Authentic Products<br>
&bull; Fast &amp; Secure Delivery<br>
&bull; Easy Returns &amp; Exchanges<br>
&bull; Responsive Customer Support
</td></tr>
</table>
</td>
</tr>

<tr>
<td style="padding:24px 40px;border-top:1px solid #e5e7eb;text-align:center;">
<p style="margin:0 0 4px;color:#6b7280;font-size:12px;">You are receiving this email because you added products to your cart at {{storeName}}.</p>
<p style="margin:0;color:#9ca3af;font-size:11px;">Need help? <a href="{{storeUrl}}/contact" style="color:#1B198F;text-decoration:none;">Contact support</a></p>
{{#if unsubscribeUrl}}<p style="margin:8px 0 0;"><a href="{{unsubscribeUrl}}" style="color:#9ca3af;font-size:11px;text-decoration:underline;">Unsubscribe from cart reminders</a></p>{{/if}}
</td>
</tr>

</table>
</td></tr>
</table>
</body>
</html>
