<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Complete Your Order</title>
</head>
<body style="margin:0;padding:0;background-color:#fbf3e8;font-family:Arial,'Helvetica Neue',Helvetica,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#fbf3e8;">
<tr><td align="center" style="padding:32px 16px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background-color:#ffffff;">

<tr>
<td style="background-color:#2e1f15;padding:24px 40px;text-align:center;">
<p style="margin:0;color:#ffffff;font-size:18px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;">The Cupcake Desire</p>
</td>
</tr>

<tr>
<td style="padding:36px 40px;">
<h2 style="margin:0 0 20px;font-size:22px;color:#2e1f15;font-weight:700;">You Left Items in Your Cart</h2>
<p style="margin:0 0 8px;font-size:15px;color:#5a4634;line-height:1.7;">Hi {{userName}},</p>
<p style="margin:0 0 24px;font-size:15px;color:#5a4634;line-height:1.7;">You were one step away from completing your order. The items below are still reserved in your cart.</p>

{{#each items}}
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:10px;background-color:#fffbf6;border-radius:4px;">
<tr>
<td style="padding:12px;" width="70"><img src="{{imageUrl}}" alt="{{productName}}" width="56" height="56" style="border-radius:4px;display:block;object-fit:cover;" /></td>
<td style="padding:12px;">
<p style="margin:0;font-size:14px;color:#2e1f15;font-weight:600;">{{productName}}</p>
<p style="margin:2px 0 0;font-size:12px;color:#8b7359;">{{variant.option1Value}} &middot; Qty: {{quantity}}</p>
</td>
<td style="padding:12px;text-align:right;font-size:14px;color:#2e1f15;font-weight:600;" width="80">${{price}}</td>
</tr>
</table>
{{/each}}

<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:20px 0;background-color:#fffbf6;border-radius:4px;">
<tr>
<td style="padding:14px 16px;font-size:16px;color:#2e1f15;font-weight:700;">Total</td>
<td style="padding:14px 16px;font-size:16px;color:#2e1f15;font-weight:700;text-align:right;">${{totalValue}}</td>
</tr>
</table>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:24px 0;">
<tr><td align="center" style="border-radius:4px;background-color:#2e1f15;">
<a href="{{resumeUrl}}" style="display:inline-block;padding:14px 32px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;width:100%;text-align:center;box-sizing:border-box;">Complete My Order</a>
</td></tr>
</table>

<table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;">
<tr>
<td style="padding:0 8px;text-align:center;font-size:13px;color:#8b7359;" width="33%">Secure Checkout</td>
<td style="padding:0 8px;text-align:center;font-size:13px;color:#8b7359;" width="34%">Fast Delivery</td>
<td style="padding:0 8px;text-align:center;font-size:13px;color:#8b7359;" width="33%">100% Authentic</td>
</tr>
</table>
</td>
</tr>

<tr>
<td style="padding:24px 40px;border-top:1px solid #ead9c1;text-align:center;">
<p style="margin:0 0 4px;color:#8b7359;font-size:12px;">You are receiving this email because you added products to your cart at {{storeName}}.</p>
<p style="margin:0;color:#a89478;font-size:11px;">Need help? <a href="{{storeUrl}}/contact" style="color:#2e1f15;text-decoration:none;">Contact support</a></p>
</td>
</tr>

</table>
</td></tr>
</table>
</body>
</html>
