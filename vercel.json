{"headers": [
  {
    "source": "/(.*)",
    "headers": [
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
      { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
    ]
  }
],

  "crons": [
    {
      "path": "/api/cart/detect-abandoned",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cart/recovery/trigger-immediate",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cart/recovery/trigger-24hour",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cart/recovery/trigger-48hour",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cart/cleanup",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/pending-order-reminder",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/review-request",
      "schedule": "0 23 * * *"
    }
  ]
}
